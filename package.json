{
  "name": "@office-open/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Akademi's Word-first OOXML engine (fork of DemoMacro/office-open v0.14.5)",
  "keywords": [
    "ai",
    "docx",
    "office",
    "office-open",
    "ooxml",
    "pptx",
    "typescript",
    "xlsx"
  ],
  "homepage": "https://www.office-open.com",
  "bugs": {
    "url": "https://github.com/akademi-ink/office-open/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Demo Macro",
    "email": "abc@imst.xyz",
    "url": "https://www.demomacro.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akademi-ink/office-open.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" -r dev",
    "build": "pnpm --filter \"./packages/**\" -r build",
    "check": "vp check --fix",
    "test": "pnpm --filter \"./packages/**\" -r test",
    "corpus:setup": "tsx scripts/corpus-check.ts --setup",
    "models:generate": "tsx scripts/xsd-content-model.ts",
    "models:check": "tsx scripts/xsd-content-model.ts --check",
    "containers:check": "tsx scripts/check-containers.ts",
    "corpus:check": "tsx scripts/corpus-check.ts",
    "version": "pnpm --filter \"./packages/**\" -r exec basis version",
    "publish": "pnpm --filter \"./packages/**\" -r exec basis publish",
    "postinstall": "pnpm build && vp config && basis git setup"
  },
  "devDependencies": {
    "@funish/basis": "0.3.0",
    "@rolldown/plugin-node-polyfills": "1.0.3",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "docx": "9.7.1",
    "execa": "10.0.1",
    "happy-dom": "20.11.6",
    "inquirer": "14.1.0",
    "libxml2-wasm": "0.7.1",
    "pptxgenjs": "4.0.1",
    "ts-json-schema-generator": "2.9.0",
    "ts-morph": "28.0.0",
    "tsx": "4.23.12",
    "vite-plus": "0.2.9"
  },
  "packageManager": "pnpm@10.33.0"
}
